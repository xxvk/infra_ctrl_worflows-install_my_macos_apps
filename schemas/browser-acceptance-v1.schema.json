{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macomrade.example/schemas/browser-acceptance-v1.schema.json",
  "title": "macomrade redacted browser live acceptance summary v1",
  "type": "object",
  "required": ["schema_version", "kind", "captured_at", "status", "scope", "runtime", "gates", "counts", "privacy", "private_content_emitted", "writes_performed", "browser_writes_performed", "execution_authorized"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "browser_live_acceptance_summary"},
    "captured_at": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["passed", "partial", "failed"]},
    "scope": {
      "type": "object",
      "required": ["browsers", "chrome_status", "safari_profile_model"],
      "properties": {
        "browsers": {"type": "array", "items": {"type": "string"}, "const": ["safari"]},
        "chrome_status": {"type": "string", "const": "deferred_by_user"},
        "safari_profile_model": {"type": "string", "const": "shared_across_profiles"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["safari_present", "safari_version", "safari_build"],
      "properties": {
        "safari_present": {"type": "boolean"},
        "safari_version": {"type": ["string", "null"]},
        "safari_build": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^BA-[0-9]{2}$"},
          "status": {"type": "string", "enum": ["passed", "deferred", "interface_limited", "failed", "not_run"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "required": ["bookmark_count", "reading_list_count", "queued_count", "suppressed_count", "planned_operation_count", "verified_operation_count", "failed_operation_count"],
      "properties": {
        "bookmark_count": {"type": "integer", "minimum": 0},
        "reading_list_count": {"type": "integer", "minimum": 0},
        "queued_count": {"type": ["integer", "null"], "minimum": 0},
        "suppressed_count": {"type": ["integer", "null"], "minimum": 0},
        "planned_operation_count": {"type": ["integer", "null"], "minimum": 0},
        "verified_operation_count": {"type": ["integer", "null"], "minimum": 0},
        "failed_operation_count": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "privacy": {
      "anyOf": [
        {
          "type": "object",
          "required": ["provenance", "storage_layer", "contains_private_content", "git_allowed", "redaction_required"],
          "properties": {
            "provenance": {"type": "string", "const": "synthetic_fixture"},
            "storage_layer": {"type": "string", "const": "public_fixture"},
            "contains_private_content": {"type": "boolean", "const": false},
            "git_allowed": {"type": "boolean", "const": true},
            "redaction_required": {"type": "boolean", "const": false}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["provenance", "storage_layer", "contains_private_content", "git_allowed", "redaction_required"],
          "properties": {
            "provenance": {"type": "string", "const": "machine_observation"},
            "storage_layer": {"type": "string", "const": "ephemeral_output"},
            "contains_private_content": {"type": "boolean", "const": false},
            "git_allowed": {"type": "boolean", "const": false},
            "redaction_required": {"type": "boolean", "const": true}
          },
          "additionalProperties": false
        }
      ]
    },
    "private_content_emitted": {"type": "boolean", "const": false},
    "writes_performed": {"type": "boolean", "const": false},
    "browser_writes_performed": {"type": "boolean", "const": false},
    "execution_authorized": {"type": "boolean", "const": false}
  },
  "additionalProperties": false
}
