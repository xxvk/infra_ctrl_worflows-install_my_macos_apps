{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macomrade.local/schemas/catalog-v1.schema.json",
  "title": "macomrade application catalog v1",
  "type": "object",
  "required": [
    "schema_version",
    "apps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "tier",
          "guide"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "core",
              "optional",
              "heavy"
            ]
          },
          "guide": {
            "type": "string",
            "pattern": "^components/.+\\.md$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "follow_up": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked_releases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "repository",
                "release",
                "status",
                "reason"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "release": {
                  "type": "string",
                  "minLength": 1
                },
                "release_url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "status": {
                  "const": "blocked"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "reconsideration_gate": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "size_gb": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
