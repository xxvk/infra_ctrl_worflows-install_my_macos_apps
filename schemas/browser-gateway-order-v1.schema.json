{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macomrade.invalid/schemas/browser-gateway-order-v1.schema.json",
  "title": "macomrade Private Safari gateway display order v1",
  "type": "object",
  "required": ["schema_version", "kind", "order_id", "created_at", "source", "policy", "folders", "summary", "privacy", "safari_execution_authorized", "execution_authorized"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "browser_gateway_order"},
    "order_id": {"type": "string", "pattern": "^bgo_[A-Za-z0-9_-]{8,}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source": {
      "type": "object",
      "required": ["convergence_id", "convergence_sha256", "active_bookmark_count"],
      "additionalProperties": false,
      "properties": {
        "convergence_id": {"type": "string", "minLength": 1},
        "convergence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "active_bookmark_count": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object",
      "required": ["tiers", "max_pinned_per_folder", "fallback"],
      "additionalProperties": false,
      "properties": {
        "tiers": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "enum": ["pinned", "core", "monitor", "trial", "low_frequency"]}},
        "max_pinned_per_folder": {"type": "integer", "const": 3},
        "fallback": {"type": "string", "const": "explicit_display_rank_only"}
      }
    },
    "folders": {
      "type": "array", "minItems": 15, "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["code", "folder_name", "items"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^[1-5][1-3]$"},
          "folder_name": {"type": "string", "minLength": 1},
          "items": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "tier", "display_rank", "reason", "execution_authorized"],
              "additionalProperties": false,
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "tier": {"type": "string", "enum": ["pinned", "core", "monitor", "trial", "low_frequency"]},
                "display_rank": {"type": "integer", "minimum": 1},
                "reason": {"type": "string", "enum": ["manual_pin", "personal_relevance", "recurring_value", "authority", "recency", "low_frequency"]},
                "execution_authorized": {"type": "boolean", "const": false}
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["folder_count", "item_count", "pinned_count", "core_count", "monitor_count", "trial_count", "low_frequency_count"],
      "additionalProperties": false,
      "properties": {
        "folder_count": {"type": "integer", "const": 15},
        "item_count": {"type": "integer", "minimum": 1},
        "pinned_count": {"type": "integer", "minimum": 0},
        "core_count": {"type": "integer", "minimum": 0},
        "monitor_count": {"type": "integer", "minimum": 0},
        "trial_count": {"type": "integer", "minimum": 0},
        "low_frequency_count": {"type": "integer", "minimum": 0}
      }
    },
    "privacy": {
      "type": "object",
      "required": ["provenance", "storage_layer", "contains_private_content", "git_allowed", "redaction_required"],
      "additionalProperties": false,
      "properties": {
        "provenance": {"type": "string", "const": "private_user_data"},
        "storage_layer": {"type": "string", "const": "private_icloud"},
        "contains_private_content": {"type": "boolean", "const": true},
        "git_allowed": {"type": "boolean", "const": false},
        "redaction_required": {"type": "boolean", "const": true}
      }
    },
    "safari_execution_authorized": {"type": "boolean", "const": false},
    "execution_authorized": {"type": "boolean", "const": false}
  }
}
