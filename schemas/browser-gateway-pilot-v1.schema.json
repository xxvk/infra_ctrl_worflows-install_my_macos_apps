{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macomrade.invalid/schemas/browser-gateway-pilot-v1.schema.json",
  "title": "Browser Gateway Pilot v1",
  "type": "object",
  "required": ["schema_version", "kind", "pilot_id", "created_at", "source", "required_directories", "temporary_collection", "groups", "checkpoints", "summary", "execution_policy", "privacy", "safari_execution_authorized", "execution_authorized"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "browser_gateway_pilot"},
    "pilot_id": {"type": "string", "pattern": "^bgpilot_[A-Za-z0-9_-]{8,}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source": {
      "type": "object",
      "required": ["organization_id", "organization_artifact_sha256", "supersedes_wave_id", "supersedes_wave_sha256", "baseline_export_sha256", "baseline_bookmark_count", "baseline_reading_list_count"],
      "properties": {
        "organization_id": {"type": "string", "minLength": 1},
        "organization_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "supersedes_wave_id": {"type": "string", "minLength": 1},
        "supersedes_wave_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_export_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_bookmark_count": {"type": "integer", "minimum": 0},
        "baseline_reading_list_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "required_directories": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "minLength": 1}}
    },
    "temporary_collection": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
    "groups": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["group_id", "batch", "proposal_id", "subdomain_code", "new_source", "retirements", "execution_authorized"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^[AB][1-5]$"},
          "batch": {"type": "string", "enum": ["batch-1", "batch-2"]},
          "proposal_id": {"type": "string", "minLength": 1},
          "subdomain_code": {"type": "string", "pattern": "^[0-9]{2}$"},
          "new_source": {
            "type": "object",
            "required": ["title", "url", "operator", "source_type", "evidence_url", "evidence_checked_on", "decision", "target_collection", "review_after_days"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "url": {"type": "string", "minLength": 1},
              "operator": {"type": "string", "minLength": 1},
              "source_type": {"type": "string", "minLength": 1},
              "evidence_url": {"type": "string", "minLength": 1},
              "evidence_checked_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "decision": {"type": "string", "const": "trial_new"},
              "target_collection": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
              "review_after_days": {"type": "integer", "const": 45}
            },
            "additionalProperties": false
          },
          "retirements": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["item_id", "item_fingerprint", "original_title", "original_url", "source_collection", "superseded_decision", "action", "target_collection", "knowledge_note_required", "execution_authorized"],
              "properties": {
                "item_id": {"type": "string", "minLength": 1},
                "item_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "original_title": {"type": "string", "minLength": 1},
                "original_url": {"type": "string", "minLength": 1},
                "source_collection": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "superseded_decision": {"type": "string", "enum": ["replace_by", "promote_to_obsidian", "archive", "delete"]},
                "action": {"type": "string", "enum": ["archive", "stage_for_purge", "promote_then_stage"]},
                "target_collection": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
                "knowledge_note_required": {"type": "boolean"},
                "execution_authorized": {"type": "boolean", "const": false}
              },
              "additionalProperties": false
            }
          },
          "execution_authorized": {"type": "boolean", "const": false}
        },
        "additionalProperties": false
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["checkpoint", "bookmark_count", "reading_list_count", "conceptual_active_count", "new_source_count", "archive_count", "staged_count", "purged_count"],
        "properties": {
          "checkpoint": {"type": "string", "enum": ["batch-1", "batch-2", "purge"]},
          "bookmark_count": {"type": "integer", "minimum": 0},
          "reading_list_count": {"type": "integer", "minimum": 0},
          "conceptual_active_count": {"type": "integer", "minimum": 0},
          "new_source_count": {"type": "integer", "minimum": 0},
          "archive_count": {"type": "integer", "minimum": 0},
          "staged_count": {"type": "integer", "minimum": 0},
          "purged_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["group_count", "new_source_count", "archive_count", "stage_for_purge_count", "untouched_old_bookmark_count", "final_bookmark_count", "reading_list_count"],
      "properties": {
        "group_count": {"type": "integer", "const": 10},
        "new_source_count": {"type": "integer", "const": 10},
        "archive_count": {"type": "integer", "const": 4},
        "stage_for_purge_count": {"type": "integer", "const": 16},
        "untouched_old_bookmark_count": {"type": "integer", "const": 291},
        "final_bookmark_count": {"type": "integer", "const": 305},
        "reading_list_count": {"type": "integer", "const": 89}
      },
      "additionalProperties": false
    },
    "execution_policy": {
      "type": "object",
      "required": ["mode", "batch_size", "purge_confirmation", "reading_list_changes_allowed", "non_manifest_changes_allowed"],
      "properties": {
        "mode": {"type": "string", "const": "manual_safari_only"},
        "batch_size": {"type": "integer", "const": 5},
        "purge_confirmation": {"type": "string", "const": "PURGE BROWSER GATEWAY PILOT 1"},
        "reading_list_changes_allowed": {"type": "boolean", "const": false},
        "non_manifest_changes_allowed": {"type": "boolean", "const": false}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["provenance", "storage_layer", "contains_private_content", "git_allowed", "redaction_required"],
      "properties": {
        "provenance": {"type": "string", "const": "private_user_data"},
        "storage_layer": {"type": "string", "const": "private_icloud"},
        "contains_private_content": {"type": "boolean", "const": true},
        "git_allowed": {"type": "boolean", "const": false},
        "redaction_required": {"type": "boolean", "const": true}
      },
      "additionalProperties": false
    },
    "safari_execution_authorized": {"type": "boolean", "const": false},
    "execution_authorized": {"type": "boolean", "const": false}
  },
  "additionalProperties": false
}
