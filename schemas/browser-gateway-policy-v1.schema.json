{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macomrade.example/schemas/browser-gateway-policy-v1.schema.json",
  "title": "macomrade browser knowledge gateway policy v1",
  "type": "object",
  "required": ["schema_version", "kind", "policy_version", "roles", "capacity", "renewal", "source_mix", "selection_score", "decisions", "subdomains", "privacy", "execution_authorized"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "browser_gateway_policy"},
    "policy_version": {"type": "string", "const": "browser-gateway-v1"},
    "roles": {
      "type": "object",
      "required": ["safari", "reading_list", "obsidian"],
      "properties": {
        "safari": {"type": "string", "const": "recurring_source_gateway"},
        "reading_list": {"type": "string", "const": "temporary_inbox"},
        "obsidian": {"type": "string", "const": "durable_knowledge"}
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "required": ["minimum_active", "target_active", "maximum_active", "core_slots", "trial_slots"],
      "properties": {
        "minimum_active": {"type": "integer", "minimum": 1},
        "target_active": {"type": "integer", "minimum": 1},
        "maximum_active": {"type": "integer", "minimum": 1},
        "core_slots": {"type": "integer", "minimum": 1},
        "trial_slots": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "renewal": {
      "type": "object",
      "required": ["one_in_one_out", "above_target_retirements_per_new", "trial_days", "source_recency_days", "retirement_target_percent", "unchanged_review_only", "live_safari_write_authorized"],
      "properties": {
        "one_in_one_out": {"type": "boolean", "const": true},
        "above_target_retirements_per_new": {"type": "integer", "minimum": 2},
        "trial_days": {"type": "integer", "minimum": 1},
        "source_recency_days": {"type": "integer", "minimum": 1},
        "retirement_target_percent": {"type": "integer", "minimum": 1},
        "unchanged_review_only": {"type": "boolean", "const": true},
        "live_safari_write_authorized": {"type": "boolean", "const": false}
      },
      "additionalProperties": false
    },
    "source_mix": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "string", "enum": ["official_primary", "professional_research", "expert_community", "data_tool"]}
    },
    "selection_score": {
      "type": "object",
      "required": ["weights", "penalties"],
      "properties": {
        "weights": {
          "type": "object",
          "required": ["authority", "recency", "signal_density", "recurring_value", "personal_relevance"],
          "properties": {
            "authority": {"type": "integer", "minimum": 0},
            "recency": {"type": "integer", "minimum": 0},
            "signal_density": {"type": "integer", "minimum": 0},
            "recurring_value": {"type": "integer", "minimum": 0},
            "personal_relevance": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "penalties": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["stale", "duplicate", "homepage_without_feed", "single_use", "low_signal", "login_wall", "unverifiable_owner"]}
        }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"type": "string", "enum": ["keep_gateway", "trial_new", "replace_by", "promote_to_obsidian", "archive", "delete", "protected"]}
    },
    "subdomains": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["code", "label", "core_slots", "trial_slots", "total_slots", "priority"],
        "properties": {
          "code": {"type": "string", "pattern": "^[1-5][1-3]$"},
          "label": {"type": "string", "minLength": 1},
          "core_slots": {"type": "integer", "minimum": 0},
          "trial_slots": {"type": "integer", "minimum": 0},
          "total_slots": {"type": "integer", "minimum": 1},
          "priority": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "privacy": {
      "type": "object",
      "required": ["public_policy_only", "private_urls_in_git", "aggregate_output_only"],
      "properties": {
        "public_policy_only": {"type": "boolean", "const": true},
        "private_urls_in_git": {"type": "boolean", "const": false},
        "aggregate_output_only": {"type": "boolean", "const": true}
      },
      "additionalProperties": false
    },
    "execution_authorized": {"type": "boolean", "const": false}
  },
  "additionalProperties": false
}
