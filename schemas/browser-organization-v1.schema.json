{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macomrade.example/schemas/browser-organization-v1.schema.json",
  "title": "macomrade Private browser organization v1",
  "type": "object",
  "required": ["schema_version", "kind", "organization_id", "created_at", "source", "taxonomy", "title_policy", "path_rules", "item_overrides", "duplicate_resolutions", "decisions", "summary", "privacy", "execution_authorized"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "browser_organization"},
    "organization_id": {"type": "string", "pattern": "^borg_[A-Za-z0-9_-]{12,}$"},
    "created_at": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["browser", "interface", "artifact_sha256", "bookmark_count", "reading_list_count", "item_count"],
      "properties": {
        "browser": {"type": "string", "const": "safari"},
        "interface": {"type": "string", "const": "safari_export_zip"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bookmark_count": {"type": "integer", "minimum": 0},
        "reading_list_count": {"type": "integer", "minimum": 0},
        "item_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "taxonomy": {
      "type": "object",
      "required": ["primary_axis", "max_semantic_depth", "project_context_owner", "reading_list_role", "top_levels"],
      "properties": {
        "primary_axis": {"type": "string", "const": "long_term_domains"},
        "max_semantic_depth": {"type": "integer", "const": 2},
        "project_context_owner": {"type": "string", "const": "obsidian"},
        "reading_list_role": {"type": "string", "const": "temporary_inbox"},
        "top_levels": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["code", "label", "emoji", "folder_name", "role", "children"],
            "properties": {
              "code": {"type": "string", "pattern": "^[0-9]{2}$"},
              "label": {"type": "string", "minLength": 1},
              "emoji": {"type": "string", "minLength": 1},
              "folder_name": {"type": "string", "minLength": 1},
              "role": {"type": "string", "enum": ["active", "archive"]},
              "children": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": ["code", "label", "emoji", "folder_name"],
                  "properties": {
                    "code": {"type": "string", "pattern": "^[0-9]{2}$"},
                    "label": {"type": "string", "minLength": 1},
                    "emoji": {"type": "string", "minLength": 1},
                    "folder_name": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "title_policy": {
      "type": "object",
      "required": ["mode", "preserve_original", "translation_allowed", "summary_allowed", "execution_authorized", "allowed_rule_ids"],
      "properties": {
        "mode": {"type": "string", "const": "conservative_deterministic_suggestions"},
        "preserve_original": {"type": "boolean", "const": true},
        "translation_allowed": {"type": "boolean", "const": false},
        "summary_allowed": {"type": "boolean", "const": false},
        "execution_authorized": {"type": "boolean", "const": false},
        "allowed_rule_ids": {
          "type": "array",
          "items": {"type": "string", "enum": ["normalize_whitespace", "remove_matching_site_suffix"]}
        }
      },
      "additionalProperties": false
    },
    "path_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "source_path", "target_path", "matched_item_count"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^borm_[A-Za-z0-9_-]{8,}$"},
          "source_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "target_path": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
          "matched_item_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "item_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "disposition", "target_collection", "note"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^bri_[A-Za-z0-9_-]{16,}$"},
          "disposition": {"type": "string", "enum": ["move", "archive", "delete"]},
          "target_collection": {"anyOf": [{"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}}, {"type": "null"}]},
          "note": {"anyOf": [{"type": "string"}, {"type": "null"}]}
        },
        "additionalProperties": false
      }
    },
    "duplicate_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "members"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^brg_[0-9a-f]{24}$"},
          "members": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["item_id", "resolution"],
              "properties": {
                "item_id": {"type": "string", "pattern": "^bri_[A-Za-z0-9_-]{16,}$"},
                "resolution": {"type": "string", "enum": ["keep", "delete", "delete_later"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "item_fingerprint", "item_type", "original_title", "suggested_title", "title_suggestion_rule_ids", "original_url", "source_collection", "assignment_basis", "rule_id", "duplicate_group_id", "disposition", "target_collection", "note", "execution_authorized"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^bri_[A-Za-z0-9_-]{16,}$"},
          "item_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "item_type": {"type": "string", "enum": ["bookmark", "reading_list"]},
          "original_title": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "suggested_title": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "title_suggestion_rule_ids": {"type": "array", "items": {"type": "string", "enum": ["normalize_whitespace", "remove_matching_site_suffix"]}},
          "original_url": {"type": "string", "minLength": 1},
          "source_collection": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "assignment_basis": {"type": "string", "enum": ["path_rule", "item_override", "reading_list_policy"]},
          "rule_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "duplicate_group_id": {"anyOf": [{"type": "string", "pattern": "^brg_[0-9a-f]{24}$"}, {"type": "null"}]},
          "disposition": {"type": "string", "enum": ["move", "archive", "delete", "delete_later", "defer"]},
          "target_collection": {"anyOf": [{"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}}, {"type": "null"}]},
          "note": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "execution_authorized": {"type": "boolean", "const": false}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["directory_rule_item_count", "ambiguous_item_count", "duplicate_group_count", "active_move_count", "archive_count", "bookmark_delete_count", "reading_list_delete_later_count", "reading_list_deferred_count", "bookmark_operation_count", "item_count"],
      "properties": {
        "directory_rule_item_count": {"type": "integer", "minimum": 0},
        "ambiguous_item_count": {"type": "integer", "minimum": 0},
        "duplicate_group_count": {"type": "integer", "minimum": 0},
        "active_move_count": {"type": "integer", "minimum": 0},
        "archive_count": {"type": "integer", "minimum": 0},
        "bookmark_delete_count": {"type": "integer", "minimum": 0},
        "reading_list_delete_later_count": {"type": "integer", "minimum": 0},
        "reading_list_deferred_count": {"type": "integer", "minimum": 0},
        "bookmark_operation_count": {"type": "integer", "minimum": 0},
        "item_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "privacy": {
      "anyOf": [
        {
          "type": "object",
          "required": ["provenance", "storage_layer", "contains_private_content", "git_allowed", "redaction_required"],
          "properties": {
            "provenance": {"type": "string", "const": "synthetic_fixture"},
            "storage_layer": {"type": "string", "const": "private_template"},
            "contains_private_content": {"type": "boolean", "const": false},
            "git_allowed": {"type": "boolean", "const": true},
            "redaction_required": {"type": "boolean", "const": false}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["provenance", "storage_layer", "contains_private_content", "git_allowed", "redaction_required"],
          "properties": {
            "provenance": {"type": "string", "const": "private_user_data"},
            "storage_layer": {"type": "string", "const": "private_icloud"},
            "contains_private_content": {"type": "boolean", "const": true},
            "git_allowed": {"type": "boolean", "const": false},
            "redaction_required": {"type": "boolean", "const": true}
          },
          "additionalProperties": false
        }
      ]
    },
    "execution_authorized": {"type": "boolean", "const": false}
  },
  "additionalProperties": false
}
