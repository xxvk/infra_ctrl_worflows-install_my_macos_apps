{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macomrade.example/schemas/browser-gateway-wave-v1.schema.json",
  "title": "macomrade Private browser gateway wave v1",
  "type": "object",
  "required": ["schema_version", "kind", "wave_id", "created_at", "policy_version", "source", "proposals", "summary", "privacy", "safari_execution_authorized", "execution_authorized"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "browser_gateway_wave"},
    "wave_id": {"type": "string", "pattern": "^bgw_[A-Za-z0-9_-]{8,}$"},
    "created_at": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "const": "browser-gateway-v1"},
    "source": {
      "type": "object",
      "required": ["organization_id", "artifact_sha256", "active_bookmark_count"],
      "properties": {
        "organization_id": {"type": "string", "pattern": "^borg_[A-Za-z0-9_-]{12,}$"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "active_bookmark_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["proposal_id", "subdomain_code", "new_source", "retirements", "review_status", "execution_authorized"],
        "properties": {
          "proposal_id": {"type": "string", "pattern": "^bgp_[A-Za-z0-9_-]{8,}$"},
          "subdomain_code": {"type": "string", "pattern": "^[1-5][1-3]$"},
          "new_source": {
            "type": "object",
            "required": ["title", "url", "operator", "source_type", "evidence_url", "evidence_checked_on", "decision"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "url": {"type": "string", "pattern": "^https://"},
              "operator": {"type": "string", "minLength": 1},
              "source_type": {"type": "string", "enum": ["official_primary", "professional_research", "expert_community", "data_tool"]},
              "evidence_url": {"type": "string", "pattern": "^https://"},
              "evidence_checked_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "decision": {"type": "string", "const": "trial_new"}
            },
            "additionalProperties": false
          },
          "retirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["item_id", "item_fingerprint", "original_title", "original_url", "original_subdomain_code", "decision"],
              "properties": {
                "item_id": {"type": "string", "pattern": "^bri_[A-Za-z0-9_-]{16,}$"},
                "item_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "original_title": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                "original_url": {"type": "string", "minLength": 1},
                "original_subdomain_code": {"type": "string", "pattern": "^[1-5][1-3]$"},
                "decision": {"type": "string", "enum": ["replace_by", "promote_to_obsidian", "archive", "delete"]}
              },
              "additionalProperties": false
            }
          },
          "review_status": {"type": "string", "const": "approved"},
          "execution_authorized": {"type": "boolean", "const": false}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["new_source_count", "retirement_count", "projected_active_count", "minimum_retirements_per_new", "private_content_emitted_to_stdout"],
      "properties": {
        "new_source_count": {"type": "integer", "minimum": 1},
        "retirement_count": {"type": "integer", "minimum": 1},
        "projected_active_count": {"type": "integer", "minimum": 0},
        "minimum_retirements_per_new": {"type": "integer", "minimum": 1},
        "private_content_emitted_to_stdout": {"type": "boolean", "const": false}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["provenance", "storage_layer", "contains_private_content", "git_allowed", "redaction_required"],
      "properties": {
        "provenance": {"type": "string", "enum": ["synthetic_fixture", "private_user_data"]},
        "storage_layer": {"type": "string", "enum": ["private_template", "private_icloud"]},
        "contains_private_content": {"type": "boolean"},
        "git_allowed": {"type": "boolean"},
        "redaction_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "safari_execution_authorized": {"type": "boolean", "const": false},
    "execution_authorized": {"type": "boolean", "const": false}
  },
  "additionalProperties": false
}
