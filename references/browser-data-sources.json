{
  "schema_version": 1,
  "kind": "browser_data_source_contract",
  "scope": {
    "browsers": ["safari"],
    "content_kinds": ["bookmark", "reading_list"],
    "chrome_status": "deferred_by_user"
  },
  "privacy": {
    "tracked": [
      "source capability",
      "format name",
      "support classification",
      "permission and profile boundary",
      "official documentation URL"
    ],
    "private_or_machine_local": [
      "export archives",
      "bookmark and Reading List URLs",
      "titles and folder names",
      "Safari profile and Apple Account mappings",
      "item counts, hashes, and observations"
    ],
    "prohibited_inputs": [
      "cookies",
      "history",
      "passwords",
      "payment cards",
      "open tabs",
      "session material",
      "undocumented cloud credentials"
    ],
    "export_selection": "bookmarks_and_reading_list_only",
    "raw_export_git_policy": "never_track"
  },
  "native_api_gates": {
    "settings_class": "SFSafariSettings",
    "export_sheet_method": "openExportBrowsingDataSettingsWithCompletionHandler:",
    "autofill_check_method": "checkAutoFillUserNamesAndPasswordsEnabledWithCompletionHandler:",
    "evidence_snapshot": "Xcode 27 Beta 5 with macOS 27 SDK",
    "selected_sdk_status": "documented_but_symbol_absent",
    "runtime_selector_status": "absent_on_verified_beta",
    "item_enumeration_supported": false,
    "adoption_gates": [
      "exact_symbol_in_selected_sdk",
      "minimal_compile_passes",
      "foreground_runtime_sheet_opens"
    ],
    "fallback": "safari_file_export_browsing_data_bookmarks_and_reading_list_only",
    "official_evidence": [
      "https://developer.apple.com/documentation/safariservices/sfsafarisettings",
      "https://developer.apple.com/documentation/safariservices/importing-data-exported-from-safari"
    ]
  },
  "sources": [
    {
      "id": "macos_data_cli",
      "browser": "safari",
      "support": "supported_cli_adapter",
      "item_enumeration_supported": true,
      "content_kinds": ["bookmark", "reading_list"],
      "minimum_read_version": "0.8.0",
      "minimum_local_write_version": "0.8.1",
      "read_commands": [
        "safari bookmarks list/query/get",
        "safari reading-list list/query/get"
      ],
      "profile_scope": "shared_across_safari_profiles",
      "authorization": "Full_Disk_Access_required_for_Bookmarks_plist_read",
      "consumer_status": "preferred_for_live_read_and_query",
      "adapter_boundary": "macos_data_owns_bounded_plist_parsing_and_opaque_ids",
      "direct_internal_store_access": "forbidden",
      "ordinary_bookmark_write_status": "available_local_only",
      "cross_device_sync_status": "not_verified",
      "write_adoption_gates": [
        "stable_public_cli_command",
        "dry_run_and_exact_confirmation",
        "Safari_quiescence_and_open_handle_gate",
        "mode_0600_backup_and_manifest",
        "atomic_replace_and_rollback",
        "Safari_visible_readback",
        "explicit_local_only_status",
        "separate_cross_device_sync_verification"
      ],
      "project_evidence": "macos-data 0.8.1 installed public CLI with guarded local-only bookmark and folder CRUD"
