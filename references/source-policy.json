{
  "schema_version": 1,
  "kind": "installation_source_policy",
  "source_classes": {
    "official_homebrew": {
      "risk": "medium",
      "pinning": "Homebrew formula/cask revision and artifact checksum resolved at apply time",
      "verification": ["brew info JSON", "package receipt or bundle", "installed version"],
      "rollback": "brew uninstall for the exact formula or cask"
    },
    "third_party_homebrew": {
      "risk": "high",
      "pinning": "full reviewed tap commit",
      "verification": ["exact tap remote", "exact tap HEAD", "package-scoped trust", "bundle or command"],
      "rollback": "uninstall exact package, revoke package trust, then untap only if no other package uses it"
    },
    "app_store": {
      "risk": "low",
      "pinning": "immutable numeric App Store item ID; version remains Apple-managed",
      "verification": ["macappstore URL", "App Store receipt", "bundle identifier and version"],
      "rollback": "remove app bundle while preserving user data unless separately approved"
    },
    "npm_global": {
      "risk": "medium",
      "pinning": "exact package version",
      "verification": ["npm package name", "requested version", "resolved version", "registry integrity when available"],
      "rollback": "npm uninstall --global exact package"
    },
    "official_web": {
      "risk": "high",
      "pinning": "vendor release when stable; otherwise capture final URL and SHA-256 before install",
      "verification": ["HTTPS vendor domain", "SHA-256", "codesign", "spctl", "bundle identifier and version"],
      "rollback": "component-specific vendor uninstaller or narrow bundle removal"
    },
    "github_source": {
      "risk": "high",
      "pinning": "full Git commit plus artifact SHA-256",
      "verification": ["official repository", "full commit", "artifact path", "SHA-256"],
      "rollback": "remove generated wrapper and package while preserving unrelated dependencies"
    },
    "web_wrapper": {
      "risk": "medium",
      "pinning": "HTTPS origin and wrapper identity",
      "verification": ["origin URL", "wrapper bundle", "account checked interactively"],
      "rollback": "remove only the named wrapper and its owned data"
    },
    "browser_extension": {
      "risk": "medium",
      "pinning": "official store listing ID",
      "verification": ["store origin", "extension ID", "browser profile"],
      "rollback": "remove from the exact browser profile"
    },
    "decrypted_ipa": {
      "risk": "critical",
      "pinning": "per-file SHA-256 and bundle identifier",
      "verification": ["Private approved source label", "explicit per-import approval", "SHA-256", "bundle identifier", "decrypted status", "PlayCover launch test"],
      "rollback": "remove only the imported PlayCover app; preserve PlayCover and Keychain unless separately approved"
    },
    "system_app": {
      "risk": "low",
      "pinning": "macOS build",
      "verification": ["system bundle path and identifier"],
      "rollback": "not managed by this skill"
    }
  },
