{
  "schema_version": 1,
  "kind": "browser_gateway_policy",
  "policy_version": "browser-gateway-v1",
  "roles": {
    "safari": "recurring_source_gateway",
    "reading_list": "temporary_inbox",
    "obsidian": "durable_knowledge"
  },
  "capacity": {
    "minimum_active": 90,
    "target_active": 100,
    "maximum_active": 110,
    "core_slots": 70,
    "trial_slots": 30
  },
  "renewal": {
    "one_in_one_out": true,
    "above_target_retirements_per_new": 2,
    "trial_days": 45,
    "source_recency_days": 365,
    "retirement_target_percent": 50,
    "unchanged_review_only": true,
    "live_safari_write_authorized": false
  },
  "source_mix": [
    "official_primary",
    "professional_research",
    "expert_community",
    "data_tool"
  ],
  "selection_score": {
    "weights": {
      "authority": 25,
      "recency": 20,
      "signal_density": 20,
      "recurring_value": 20,
      "personal_relevance": 15
    },
    "penalties": [
      "stale",
      "duplicate",
      "homepage_without_feed",
      "single_use",
      "low_signal",
      "login_wall",
      "unverifiable_owner"
    ]
  },
  "decisions": [
    "keep_gateway",
    "trial_new",
    "replace_by",
    "promote_to_obsidian",
    "archive",
    "delete",
    "protected"
  ],
