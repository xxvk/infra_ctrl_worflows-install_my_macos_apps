{
  "schema_version": 1,
  "kind": "storage_policy",
  "default_role": "auto",
  "role_targets_bytes": {
    "compact": 53687091200,
    "expanded": 107374182400
  },
  "private_overridable": [
    "target_free_bytes",
    "path_rules",
    "archive_targets"
  ],
  "execution_authorized": false,
  "candidate_thresholds": {
    "allocated_bytes": 104857600,
    "cloud_logical_bytes": 1073741824,
    "cloud_local_ratio_max": 0.1,
    "summary_limit": 50,
    "weekly_new_bytes": 5368709120
  },
  "decision_ttl_days": {
    "keep_local": 180,
    "safe_cache": 30
  },
  "scan_roots": {
    "quick": [
      "~/Desktop",
      "~/Documents",
      "~/Downloads",
      "~/Movies",
      "~/Pictures",
      "~/Library/Caches/Homebrew",
      "~/.npm/_cacache",
      "~/Library/pnpm/store",
      "~/.cache/uv",
      "~/.cache/mole",
      "~/.gradle/caches",
      "~/.gradle/daemon",
      "~/.cache/puppeteer",
      "~/Library/Caches/node-gyp",
      "~/Library/Caches/ms-playwright-go",
      "~/Library/Caches/pnpm",
      "~/Library/Developer/Xcode/DerivedData"
    ],
    "deep": [
      "~/Desktop",
      "~/Documents",
      "~/Downloads",
      "~/Movies",
      "~/Pictures",
      "~/Library/Caches/Homebrew",
      "~/.npm/_cacache",
      "~/Library/pnpm/store",
      "~/.cache/uv",
      "~/.cache/mole",
      "~/.gradle/caches",
      "~/.gradle/daemon",
      "~/.cache/puppeteer",
      "~/Library/Caches/node-gyp",
      "~/Library/Caches/ms-playwright-go",
      "~/Library/Caches/pnpm",
      "~/Library/Developer/Xcode/DerivedData",
      "~/Library/Application Support"
    ]
  },
  "developer_artifact_roots": [
    "~/Developer",
    "~/Projects",
    "~/Documents/GitHub"
  ],
  "path_rules": [
    {
      "pattern": "~/Library/Caches/Homebrew*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "Homebrew downloads and metadata are regenerated by supported brew operations."
    },
    {
      "pattern": "~/.npm/_cacache*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "npm's content-addressable cache is recreated by npm fetch and install operations."
    },
    {
      "pattern": "~/Library/pnpm/store*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "The pnpm content-addressable store is repopulated from package registries."
    },
    {
      "pattern": "~/.cache/uv*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "uv recreates its download and build cache from declared Python dependencies."
    },
    {
      "pattern": "~/.cache/mole*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "Mole recreates its scan cache during later analyze and cleanup inspections; clearing it removes history acceleration, not user content."
    },
    {
      "pattern": "~/.gradle/caches*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "Gradle recreates dependency and build caches from project files and remote repositories; the next build may be slower."
    },
    {
      "pattern": "~/.gradle/daemon*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "Gradle recreates daemon state and logs when a later build starts a new daemon."
    },
    {
      "pattern": "~/.cache/puppeteer*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "Puppeteer redownloads compatible managed browser binaries when required."
    },
    {
      "pattern": "~/Library/Caches/node-gyp*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "node-gyp redownloads Node.js headers and rebuilds native modules from package sources."
    },
    {
      "pattern": "~/Library/Caches/ms-playwright-go*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "Playwright for Go redownloads its managed browser binaries when installation or a later run requires them."
    },
    {
      "pattern": "~/Library/Caches/pnpm*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "pnpm recreates package-manager cache metadata from project manifests and registries."
    },
    {
      "pattern": "~/Library/Developer/Xcode/DerivedData*",
      "kind": "developer_cache",
      "decision": "safe_cache",
      "regeneration_proof": "Xcode rebuilds DerivedData from project sources; the next build may be slower."
    },
    {
      "pattern": "~/Library/Application Support*",
      "kind": "app_support_aggregate",
      "decision": "protected"
    }
  ],
  "archive_targets": [],
  "providers": {
    "icloud": "inspect_and_evict",
    "third_party_file_provider": "inspect_only",
    "external_and_nas": "explicit_only"
  },
  "weekly": {
    "enabled_by_default": false,
    "read_only": true,
    "low_battery_percent": 20,
    "cooldown_hours": 168,
    "auto_cleanup": false
  }
}
